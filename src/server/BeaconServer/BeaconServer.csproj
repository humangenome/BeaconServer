<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BeaconServer</RootNamespace>
    <UserSecretsId>beacon-server-dev</UserSecretsId>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BeaconServer.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="LiteNetLib" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>
  <ItemGroup>
    <!-- Vendored joric map app (Unlicense) served at GET /map/. Copied to
         output as map/** so BeaconHttpService serves it same-origin; tiles
         load on demand from our GitHub Pages tileset. The SDK auto-includes
         the .json files as Content, so clear the implicit items first and
         re-add the whole tree with copy-to-output + a map/ link. -->
    <Content Remove="Static\map\**\*" />
    <None Remove="Static\map\**\*" />
    <Content Include="Static\map\**\*">
      <Link>map\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../shared/Beacon.Protocol/Beacon.Protocol.csproj" />
    <ProjectReference Include="../../shared/Beacon.Abstractions/Beacon.Abstractions.csproj" />
    <ProjectReference Include="../Beacon.SourceQuery/Beacon.SourceQuery.csproj" />
    <ProjectReference Include="../Beacon.Rcon/Beacon.Rcon.csproj" />
    <ProjectReference Include="../Beacon.Persistence/Beacon.Persistence.csproj" />
  </ItemGroup>
</Project>
